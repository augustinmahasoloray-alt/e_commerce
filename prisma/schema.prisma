// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
}

// ============ ENUMS ============

enum Role {
  client
  admin
}

enum OrderStatus {
  en_attente
  confirmee
  expediee
  livree
  annulee
}

enum ReviewStatus {
  en_attente
  approuve
  rejete
}

enum CouponType {
  pourcentage
  montant_fixe
}

// ============ USERS & ADDRESSES ============

model User {
  id                String   @id @default(uuid())
  nom               String
  prenom            String
  email             String   @unique
  mot_de_passe_hash String
  telephone         String?
  role              Role     @default(client)
  date_creation     DateTime @default(now())

  addresses Address[]
  cart      Cart?
  orders    Order[]
  reviews   Review[]
  wishlist  Wishlist[]

  @@map("users")
}

model Address {
  id          String  @id @default(uuid())
  user_id     String
  ligne1      String
  ligne2      String?
  ville       String
  code_postal String
  pays        String
  is_default  Boolean @default(false)

  user   User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  orders Order[]

  @@map("addresses")
}

// ============ CATEGORIES & BRANDS ============

model Category {
  id        String @id @default(uuid())
  nom       String
  parent_id String?

  parent   Category?  @relation("CategoryToSubcategory", fields: [parent_id], references: [id])
  children Category[] @relation("CategoryToSubcategory")
  products Product[]

  @@map("categories")
}

model Brand {
  id       String  @id @default(uuid())
  nom      String
  logo_url String?

  products Product[]

  @@map("brands")
}

// ============ PRODUCTS ============

model Product {
  id            String   @id @default(uuid())
  nom           String
  description   String?
  category_id   String
  brand_id      String
  prix          Decimal  @db.Decimal(10, 2)
  prix_promo    Decimal? @db.Decimal(10, 2)
  note_moyenne  Decimal  @default(0) @db.Decimal(3, 2)
  actif         Boolean  @default(true)
  date_creation DateTime @default(now())

  category Category         @relation(fields: [category_id], references: [id])
  brand    Brand            @relation(fields: [brand_id], references: [id])
  variants ProductVariant[]
  images   ProductImage[]
  reviews  Review[]
  wishlist Wishlist[]

  @@map("products")
}

model ProductVariant {
  id         String @id @default(uuid())
  product_id String
  taille     String
  couleur    String
  stock      Int    @default(0)
  sku        String @unique

  product     Product     @relation(fields: [product_id], references: [id], onDelete: Cascade)
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@map("product_variants")
}

model ProductImage {
  id         String @id @default(uuid())
  product_id String
  url        String
  ordre      Int    @default(0)

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@map("product_images")
}

// ============ CART ============

model Cart {
  id      String @id @default(uuid())
  user_id String @unique

  user  User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id         String @id @default(uuid())
  cart_id    String
  variant_id String
  quantite   Int    @default(1)

  cart    Cart           @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variant_id], references: [id])

  @@map("cart_items")
}

// ============ WISHLIST ============

model Wishlist {
  id         String   @id @default(uuid())
  user_id    String
  product_id String
  date_ajout DateTime @default(now())

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([user_id, product_id])
  @@map("wishlist")
}

// ============ ORDERS ============

model Order {
  id              String      @id @default(uuid())
  user_id         String
  address_id      String
  coupon_id       String?
  statut          OrderStatus @default(en_attente)
  mode_paiement   String
  mode_livraison  String
  montant_total   Decimal     @db.Decimal(10, 2)
  date_commande   DateTime    @default(now())

  user    User        @relation(fields: [user_id], references: [id])
  address Address     @relation(fields: [address_id], references: [id])
  coupon  Coupon?     @relation(fields: [coupon_id], references: [id])
  items   OrderItem[]

  @@map("orders")
}

model OrderItem {
  id             String  @id @default(uuid())
  order_id       String
  variant_id     String
  quantite       Int
  prix_unitaire  Decimal @db.Decimal(10, 2)

  order   Order          @relation(fields: [order_id], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variant_id], references: [id])

  @@map("order_items")
}

// ============ REVIEWS ============

model Review {
  id          String       @id @default(uuid())
  product_id  String
  user_id     String
  note        Int
  commentaire String?
  statut      ReviewStatus @default(en_attente)
  date        DateTime     @default(now())

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("reviews")
}

// ============ COUPONS ============

model Coupon {
  id          String     @id @default(uuid())
  code        String     @unique
  type        CouponType
  valeur      Decimal    @db.Decimal(10, 2)
  date_debut  DateTime
  date_fin    DateTime
  usage_max   Int
  actif       Boolean    @default(true)

  orders Order[]

  @@map("coupons")
}